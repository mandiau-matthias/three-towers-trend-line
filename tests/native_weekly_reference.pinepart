// Independent oracle: scalar EMA, built-in ATR, history-indexed KAMA and a Boolean SMA
// for confirmation. Missing calendar weeks suspend KAMA and confirmation until
// the declared lookback is contiguous again. Malformed OHLC remains unsupported.
f_reference() =>
    int n = wErLength
    int e = wEmaLength
    int a = wAtrLength
    int ks = wKamaSlope
    int es = wEmaSlope
    int warm = wWarmup
    int ordinal = int(time/WEEK_MS)
    bool inputOkay = not na(close) and low > 0 and high >= math.max(open,close) and low <= math.min(open,close)
    var bool clean = true
    clean := clean and inputOkay
    // Match the declared first-close EMA seed explicitly; the native built-in
    // was observed to return na during its initialization on this feed.
    float alpha = 2.0/(e+1)
    var float average = na
    average := alpha*close+(1-alpha)*nz(average[1],close)
    float volatility = ta.atr(a)
    float seed = ta.sma(close,n)
    float movement = 0.0
    for i = 0 to n-1
        movement += math.abs(close[i]-close[i+1])
    float efficiency = movement == 0 ? 0 : math.abs(close-close[n])/movement
    float sc = math.pow(efficiency*(2.0/(fastLength+1)-2.0/(slowLength+1))+2.0/(slowLength+1),2)
    var float adaptive = na
    if bar_index == n-1
        adaptive := seed
    else if bar_index >= n and ordinal-ordinal[n] == n
        adaptive := adaptive[1]+sc*(close-adaptive[1])
    bool contiguous = bar_index > 0 and ordinal-ordinal[1] == 1
    bool historyReady = bar_index >= n and ordinal-ordinal[n] == n and ordinal-ordinal[ks] == ks and ordinal-ordinal[es] == es
    bool ready = clean and contiguous and historyReady and bar_index >= math.max(warm,math.max(e,a))-1 and not na(adaptive[ks]) and not na(average[es]) and not na(volatility)
    int ups = (close > adaptive+atrBuffer*volatility ? 1 : 0)+(adaptive > adaptive[ks] ? 1 : 0)+(close > average and average > average[es] ? 1 : 0)
    int downs = (close < adaptive-atrBuffer*volatility ? 1 : 0)+(adaptive < adaptive[ks] ? 1 : 0)+(close < average and average < average[es] ? 1 : 0)
    float confirmedUp = ta.sma(ready and ups==3 ? 1.0 : 0.0,confirmation)
    bool belowBand = close < adaptive-atrBuffer*volatility
    float confirmedDown = ta.sma(ready and (bandExit ? belowBand : downs==3) ? 1.0 : 0.0,confirmation)
    var int direction = 0
    if ready and confirmedUp == 1
        direction := 1
    else if ready and confirmedDown == 1
        direction := -1
    bool upEvent = direction==1 and nz(direction[1])!=1
    bool downEvent = direction==-1 and nz(direction[1])!=-1
    var bool weak = false
    bool nextWeak = direction==1 and (bandExit ? belowBand : downs>=2)
    bool weakEvent = ready and nextWeak and not weak
    if ready
        weak := nextWeak
    var int flip = na
    var float flipClose = na
    var int duration = 0
    if upEvent or downEvent
        flip := time_close
        flipClose := close
        duration := 0
    if ready and direction!=0
        duration += 1
    var int first = time
    // Negative count makes unsupported input assumptions visible to the checker.
    Towers.new(adaptive,average,volatility,direction,weak,ready,time_close,flip,clean ? bar_index+1 : -1,ups,downs,upEvent,downEvent,weakEvent,flipClose,duration,close,first)

f_reference_previous() =>
    Towers s = f_reference()
    s[1]

Towers reference = na
if nativeTf
    Towers r = f_reference()
    reference := barstate.isconfirmed ? r : r[1]
else
    reference := request.security(syminfo.tickerid,signalTf,f_reference_previous(),gaps=barmerge.gaps_off,lookahead=barmerge.lookahead_on)

f_matches(float one, float two, bool exact) =>
    na(one) ? na(two) : not na(two) and (exact ? one==two : math.abs(one-two)<=math.max(1e-12,math.abs(two)*1e-9))

var int checked = 0
var int errors = 0
var int inputsUnsupported = 0
var int calendarGaps = 0
var int flipsSeen = 0
var int warningsSeen = 0
var string firstMismatch = "None"
if barstate.isfirst and not weekly
    runtime.error("Run this independent calculation oracle on 1W. A nonzero unsupported-input count prevents sign-off.")
if barstate.isconfirmed and not na(reference) and not na(asset)
    checked += 1
    calendarGaps += not na(time[1]) and int(time/WEEK_MS)-int(time[1]/WEEK_MS)!=1 ? 1 : 0
    inputsUnsupported += reference.validBars < 0 ? 1 : 0
    bool refReady = reference.ready and reference.confirmedAt == (barstate.isconfirmed ? time_close : time) and reference.confirmedAt <= asOf
    bool refPublish = refReady and (nativeTf or time == reference.confirmedAt)
    int refEvent = refPublish ? (reference.bullEvent ? 1 : reference.bearEvent ? -1 : reference.warnEvent ? 2 : 0) : 0
    int actualEvent = bull ? 1 : bear ? -1 : warning ? 2 : 0
    array<float> actual = array.from(asset.line,asset.ema,asset.atr,float(asset.regime),asset.weakening?1.0:0.0,assetReady?1.0:0.0,float(asset.confirmedAt),float(actualEvent),float(asset.validBars),float(asset.firstSourceAt),float(asset.lastFlipAt),float(asset.regimeBars))
    array<float> wanted = array.from(reference.line,reference.ema,reference.atr,float(reference.regime),reference.weakening?1.0:0.0,refReady?1.0:0.0,float(reference.confirmedAt),float(refEvent),float(reference.validBars),float(reference.firstSourceAt),float(reference.lastFlipAt),float(reference.regimeBars))
    for i=0 to 11
        if not f_matches(array.get(actual,i),array.get(wanted,i),i>=3)
            errors += 1
            if firstMismatch=="None"
                firstMismatch := str.format_time(time,"yyyy-MM-dd","UTC")+" field "+str.tostring(i)
                log.warning("Mismatch {0}; kernel {1}; oracle {2}",firstMismatch,str.tostring(array.get(actual,i),"#.############"),str.tostring(array.get(wanted,i),"#.############"))
    flipsSeen += math.abs(actualEvent)==1 ? 1 : 0
    warningsSeen += actualEvent==2 ? 1 : 0
var table proof = table.new(position.middle_right,2,8,bgcolor=color.rgb(11,15,20),frame_color=color.rgb(179,145,86),frame_width=1)
if barstate.islastconfirmedhistory or barstate.islast
    bool passed = checked>0 and errors==0 and inputsUnsupported==0
    table.cell(proof,0,0,"INDEPENDENT PINE",text_color=color.white)
    table.cell(proof,1,0,passed?"PASS":"REVIEW",text_color=passed?gold:color.orange)
    f_row(proof,1,"Chart samples",str.tostring(checked),color.white)
    f_row(proof,2,"Calculation / event errors",str.tostring(errors),color.white)
    f_row(proof,3,"Unsupported input samples",str.tostring(inputsUnsupported),color.white)
    f_row(proof,4,"Confirmed flips",str.tostring(flipsSeen),color.white)
    f_row(proof,5,"Warning starts",str.tostring(warningsSeen),color.white)
    f_row(proof,6,"First mismatch",firstMismatch,color.white)

    f_row(proof,7,"Calendar gaps reviewed",str.tostring(calendarGaps),color.white)
