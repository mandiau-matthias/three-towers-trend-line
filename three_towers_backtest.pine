bool bandExit = exitRuleName == "Below the trend band"
string btcSymbol = input.symbol("BITSTAMP:BTCUSD", "BTC reference", group = "Market context", display = display.none)
int WEEK_MS = 604800000

type Towers
    float line
    float ema
    float atr
    int regime
    bool weakening
    bool ready
    int confirmedAt
    int lastFlipAt
    int validBars
    int bullVotes
    int bearVotes
    bool bullEvent
    bool bearEvent
    bool warnEvent
    float flipPrice
    int regimeBars
    float price
    int firstSourceAt

f_engine() =>
    var int firstSourceAt = time
    int erLength = wErLength
    int emaLength = wEmaLength
    int atrLength = wAtrLength
    int kamaSlope = wKamaSlope
    int emaSlope = wEmaSlope
    int warmup = wWarmup
    int periodId = int(time / WEEK_MS)
    var array<float> prices = array.new_float()
    var array<float> lines = array.new_float()
    var array<float> averages = array.new_float()
    var array<int> stamps = array.new_int()
    var float kama = na
    var float ema = na
    var float atr = na
    var float trSeed = 0.0
    var int validBars = 0
    var int bullRun = 0
    var int bearRun = 0
    var int regime = 0
    var bool weakening = false
    var int lastFlip = na
    var float flipPrice = na
    var int regimeBars = 0
    var int lastValidTime = na
    bool valid = not na(open) and not na(high) and not na(low) and not na(close) and low > 0 and high >= math.max(open, close) and low <= math.min(open, close)
    bool contiguous = not na(lastValidTime) and periodId - lastValidTime == 1
    bool ready = false
    bool bullEvent = false
    bool bearEvent = false
    bool warnEvent = false
    int bullVotes = 0
    int bearVotes = 0
    if not valid or not contiguous
        bullRun := 0
        bearRun := 0
    if valid
        int sizeBefore = array.size(prices)
        float previousClose = sizeBefore > 0 ? array.get(prices, sizeBefore - 1) : na
        float tr = na(previousClose) ? high - low : math.max(high - low, math.max(math.abs(high - previousClose), math.abs(low - previousClose)))
        validBars += 1
        ema := na(ema) ? close : ema + 2.0 / (emaLength + 1.0) * (close - ema)
        if validBars <= atrLength
            trSeed += tr
            if validBars == atrLength
                atr := trSeed / atrLength
        else
            atr := atr + (tr - atr) / atrLength
        array.push(prices, close)
        array.push(stamps, periodId)
        int n = array.size(prices)
        bool erAvailable = n > erLength and periodId - array.get(stamps, n - erLength - 1) == erLength
        if na(kama) and n >= erLength
            float seed = 0.0
            for i = n - erLength to n - 1
                seed += array.get(prices, i)
            kama := seed / erLength
        else if not na(kama) and erAvailable
            float movement = 0.0
            for i = n - erLength to n - 1
                movement += math.abs(array.get(prices, i) - array.get(prices, i - 1))
            float efficiency = movement == 0 ? 0.0 : math.abs(close - array.get(prices, n - erLength - 1)) / movement
            float slowFactor = 2.0 / (slowLength + 1.0)
            float factor = math.pow(efficiency * (2.0 / (fastLength + 1.0) - slowFactor) + slowFactor, 2)
            kama := kama + factor * (close - kama)
        array.push(lines, kama)
        array.push(averages, ema)
        bool slopesAvailable = n > math.max(kamaSlope, emaSlope) and periodId - array.get(stamps, n - kamaSlope - 1) == kamaSlope and periodId - array.get(stamps, n - emaSlope - 1) == emaSlope
        ready := validBars >= math.max(warmup, math.max(emaLength, atrLength)) and erAvailable and slopesAvailable and contiguous and not na(array.get(lines, n - kamaSlope - 1)) and not na(kama) and not na(atr)
        if ready
            float oldKama = array.get(lines, n - kamaSlope - 1)
            float oldEma = array.get(averages, n - emaSlope - 1)
            bullVotes := (close > kama + atrBuffer * atr ? 1 : 0) + (kama > oldKama ? 1 : 0) + (close > ema and ema > oldEma ? 1 : 0)
            bearVotes := (close < kama - atrBuffer * atr ? 1 : 0) + (kama < oldKama ? 1 : 0) + (close < ema and ema < oldEma ? 1 : 0)
            bool belowBand = close < kama - atrBuffer * atr
            bool exitCondition = bandExit ? belowBand : bearVotes == 3
            bullRun := bullVotes == 3 ? bullRun + 1 : 0
            bearRun := exitCondition ? bearRun + 1 : 0
            int previousRegime = regime
            if bullRun >= confirmation
                regime := 1
            else if bearRun >= confirmation
                regime := -1
            bullEvent := regime == 1 and previousRegime != 1
            bearEvent := regime == -1 and previousRegime != -1
            if bullEvent or bearEvent
                lastFlip := time_close
                flipPrice := close
                regimeBars := 0
            if regime != 0
                regimeBars += 1
            // 1.5: the warning is the first week of the exit rule itself, so a warning
            // that repeats on the next weekly close becomes the SELL.
            bool nextWarning = regime == 1 and (bandExit ? belowBand : bearVotes >= 2)
            warnEvent := nextWarning and not weakening
            weakening := nextWarning
        else
            bullRun := 0
            bearRun := 0
        lastValidTime := periodId
        int keep = math.max(erLength + 1, math.max(kamaSlope, emaSlope) + 1)
        if array.size(prices) > keep
            array.shift(prices)
            array.shift(lines)
            array.shift(averages)
            array.shift(stamps)
    // Unavailable samples retain internal regime/warning memory, but are gray and silent.
    Towers.new(kama, ema, atr, regime, weakening, ready, time_close, lastFlip, validBars, bullVotes, bearVotes, bullEvent, bearEvent, warnEvent, flipPrice, regimeBars, close, firstSourceAt)

f_previous() =>
    Towers state = f_engine()
    state[1]

f_name(Towers state, bool fresh) =>
    not fresh ? "Data unavailable" : not state.ready ? "Initializing / data gap" : state.regime == 1 ? "BULLISH" : state.regime == -1 ? "BEARISH" : "Awaiting confirmation"

f_date(int stamp) =>
    na(stamp) ? "Not available" : str.format_time(stamp, "yyyy-MM-dd HH:mm", "UTC")

// Daily opening records are independent of the viewing chart's bars.
// No developing daily close, high or low participates in an execution example.
int DAY_MS = 86400000
int HISTORY_DAYS = 12000

type DayRecord
    Towers state
    int at
    float opening
    bool validOpen

f_day() =>
    Towers confirmed = request.security(syminfo.tickerid, "1W", f_previous(), gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_on)
    DayRecord.new(confirmed, time, open, not na(open) and open > 0)

// Used only when an irregular/tick view skips daily publications. Bounded recovery
// cannot manufacture older data; a gap outside the buffer invalidates its examples.
f_day_tail() =>
    DayRecord item = f_day()
    var array<DayRecord> history = array.new<DayRecord>()
    history.push(item)
    if history.size() > 800
        history.shift()
    barstate.islast ? history : na

type TradeExample
    int buyAt
    int sellAt
    float buyOpen
    float sellOpen
    float unitCost
    float unitProceeds
    float stagedFactor
    int purchases
    int trims
    int nextBuyAt

type ExampleBook
    array<TradeExample> pairs
    array<int> days
    array<float> opens
    array<int> gaps
    float entry = na
    int entryAt = na
    int incomplete = 0
    int losing = 0
    int lastDay = na
    int lastWeek = na
    float stageCash = 1.0
    float stageQty = 0.0
    float stageTranche = na
    bool stageFrozen = false
    bool stageValid = true
    int purchases = 0
    int trims = 0
    int gapCount = 0

method discard(ExampleBook book) =>
    if not na(book.entryAt)
        book.incomplete += 1
    book.entry := na
    book.entryAt := na
    book.stageValid := false

method consume(ExampleBook book, DayRecord item) =>
    if not na(item) and (na(book.lastDay) or item.at > book.lastDay)
        bool dayGap = not na(book.lastDay) and item.at != book.lastDay + DAY_MS
        if dayGap or not item.validOpen
            book.gapCount += 1
        book.days.push(item.at)
        book.opens.push(item.validOpen ? item.opening : na)
        book.gaps.push(book.gapCount)
        if book.days.size() > HISTORY_DAYS
            book.days.shift()
            book.opens.shift()
            book.gaps.shift()
        Towers s = item.state
        bool newWeek = not na(s) and (na(book.lastWeek) or s.confirmedAt > book.lastWeek)
        if newWeek
            bool skippedWeek = not na(book.lastWeek) and s.confirmedAt != book.lastWeek + WEEK_MS
            if skippedWeek
                book.discard()
            bool boundary = item.at == s.confirmedAt
            bool priced = boundary and item.validOpen
            float cost = item.opening * (1 + exampleSlippage / 100) * 1.003
            float proceeds = item.opening * (1 - exampleSlippage / 100) * 0.997
            if not s.ready
                book.discard()
            if s.ready and s.bullEvent
                if book.pairs.size() > 0
                    TradeExample latestPair = book.pairs.last()
                    latestPair.nextBuyAt := s.confirmedAt
                book.discard()
                book.entryAt := priced ? s.confirmedAt : na
                book.entry := priced ? item.opening : na
                book.stageCash := 1.0
                book.stageQty := 0.0
                book.stageTranche := na
                book.stageFrozen := false
                book.stageValid := priced
                book.purchases := 0
                book.trims := 0
                if not priced
                    book.incomplete += 1
            if not na(book.entryAt) and s.ready
                if not priced
                    book.stageValid := false
                // SELL has priority over every staging action.
                if s.bearEvent
                    if priced
                        float unitCost = book.entry * (1 + exampleSlippage / 100) * 1.003
                        float factor = book.stageValid ? book.stageCash + book.stageQty * proceeds : na
                        book.pairs.push(TradeExample.new(book.entryAt, s.confirmedAt, book.entry, item.opening, unitCost, proceeds, factor, book.purchases, book.trims, na))
                        if proceeds < unitCost
                            book.losing += 1
                        if book.pairs.size() > 300
                            book.pairs.shift()
                    else
                        book.incomplete += 1
                    book.entry := na
                    book.entryAt := na
                    book.stageCash += priced ? book.stageQty * proceeds : 0
                    book.stageQty := 0
                else if s.regime == 1 and book.stageValid
                    if s.weakening
                        if not book.stageFrozen
                            book.stageFrozen := true
                            book.stageTranche := book.stageQty * 0.1
                        float amount = math.min(book.stageQty, nz(book.stageTranche))
                        if amount > 0
                            book.stageCash += amount * proceeds
                            book.stageQty := math.max(0, book.stageQty - amount)
                            book.trims += 1
                    else if not book.stageFrozen and book.purchases < 10
                        float budget = math.min(0.1, book.stageCash)
                        book.stageQty += budget / cost
                        book.stageCash := math.max(0, book.stageCash - budget)
                        book.purchases += 1
            book.lastWeek := s.confirmedAt
        book.lastDay := item.at
    book

f_open_at(ExampleBook book, int at) =>
    int i = book.days.binary_search_leftmost(at)
    i >= 0 and i < book.days.size() and book.days.get(i) == at ? book.opens.get(i) : na

f_delay(ExampleBook book, TradeExample pair, int buyDelay, int sellDelay) =>
    float cost = na
    float proceeds = na
    if not na(pair)
        int buyAt = pair.buyAt + buyDelay * DAY_MS
        int sellAt = pair.sellAt + sellDelay * DAY_MS
        int first = book.days.binary_search_leftmost(pair.buyAt)
        int last = book.days.binary_search_leftmost(sellAt)
        bool continuous = first >= 0 and last >= 0 and first < book.days.size() and last < book.days.size()
        if continuous
            continuous := book.days.get(first) == pair.buyAt and book.days.get(last) == sellAt and book.gaps.get(first) == book.gaps.get(last)
        bool eligible = buyAt < pair.sellAt and sellAt > buyAt and (na(pair.nextBuyAt) or sellAt < pair.nextBuyAt)
        if continuous and eligible
            float buyOpen = f_open_at(book, buyAt)
            float sellOpen = f_open_at(book, sellAt)
            if not na(buyOpen) and not na(sellOpen)
                cost := buyOpen * (1 + exampleSlippage / 100) * 1.003
                proceeds := sellOpen * (1 - exampleSlippage / 100) * 0.997
    [cost, proceeds]

f_number(float value) =>
    na(value) ? "None" : value != 0 and math.abs(value) < 0.000000000001 ? (value < 0 ? "−" : "+") + "<0.000000000001" : str.tostring(value, math.abs(value) < 1 ? "0.############" : "#,##0.00")

f_percent(float value) =>
    na(value) ? "Unavailable" : value != 0 and math.abs(value) < 0.1 ? (value < 0 ? "−" : "+") + "<0.1%" : (value > 0 ? "+" : value < 0 ? "−" : "") + str.tostring(math.abs(value), "0.0") + "%"

f_trade_return(TradeExample pair) =>
    na(pair) or na(pair.unitCost) or pair.unitCost <= 0 or na(pair.unitProceeds) ? na : 100 * (pair.unitProceeds / pair.unitCost - 1)

// Display precision never changes the underlying confirmation timestamp.
f_confirmation_time(int value) =>
    na(value) ? "None" : str.format_time(value, "d MMM yyyy · HH:mm", "UTC")

f_readable_date(int value) =>
    // Match the platform's en-GB day-only dates, including its "Sept" spelling.
    // Exact timestamps remain available in technical tooltips, alerts and data.
    na(value) ? "Date unavailable" : str.replace(str.format_time(value, "d MMM yyyy", "UTC"), " Sep ", " Sept ")

f_badge_date(int value) =>
    f_readable_date(value)

f_example_asset() =>
    switch syminfo.prefix + ":" + syminfo.ticker
        "PULSEX:HEXWPLS_F1F4EE.USD" => "pHEX"
        "PULSEX:WPLSDAI_E56043.USD" => "WPLS"
        "PULSEX:PLSXWPLS_1B45B9.USD" => "PLSX"
        => syminfo.basecurrency != "" ? syminfo.basecurrency : "units"

f_quantity() =>
    str.tostring(exampleQuantity, "#,##0.########") + " " + f_example_asset()

f_trade_tip(TradeExample pair) =>
    string result = f_percent(f_trade_return(pair)) + " AFTER ESTIMATED COSTS\n\nBUY  " + f_readable_date(pair.buyAt) + "\nOpening price  " + f_number(pair.buyOpen) + " " + syminfo.currency + "\n\nSELL  " + f_readable_date(pair.sellAt) + "\nOpening price  " + f_number(pair.sellOpen) + " " + syminfo.currency
    string basis = "\n\nHistorical simulation · loaded chart history\n0.3% fee + " + str.tostring(exampleSlippage, "0.0") + "% slippage per side.\nOpening prices exclude these estimated costs.\nThe adaptive line is not the traded price."
    result + basis + "\n\nCalculate for an amount in Settings > Panel view\n> Trade calculator. All dates UTC.\nModel " + (bandExit ? "weekly-1.5.0" : "weekly-1.0.0") + " · build " + BUILD_ID + "\nReconstructed from this feed, not a live publication log."

type Context
    float average
    float tenkan
    float kijun
    float cloudA
    float cloudB
    float price
    int confirmedAt

f_context() =>
    // Require full consecutive UTC crypto days, including the displaced cloud history.
    bool validDay = not na(open) and not na(close) and not na(high) and not na(low) and low > 0 and high >= math.max(open, close) and low <= math.min(open, close)
    float validCount = ta.cum(validDay ? 1.0 : 0.0)
    bool full9 = time - time[8] == 8 * 86400000 and validCount - nz(validCount[9]) == 9
    bool full26 = time - time[25] == 25 * 86400000 and validCount - nz(validCount[26]) == 26
    bool full52 = time - time[51] == 51 * 86400000 and validCount - nz(validCount[52]) == 52
    bool full77 = time - time[76] == 76 * 86400000 and validCount - nz(validCount[77]) == 77
    bool full200 = time - time[199] == 199 * 86400000 and validCount - nz(validCount[200]) == 200
    float tenkanRaw = math.avg(ta.highest(high, 9), ta.lowest(low, 9))
    float kijunRaw = math.avg(ta.highest(high, 26), ta.lowest(low, 26))
    float tenkan = full9 ? tenkanRaw : na
    float kijun = full26 ? kijunRaw : na
    float spanA = math.avg(tenkan, kijun)
    float spanBRaw = math.avg(ta.highest(high, 52), ta.lowest(low, 52))
    float spanB = full52 ? spanBRaw : na
    float average = ta.sma(close, 200)
    // TradingView's standard displacement 26 uses plot offset 26 - 1.
    Context.new(full200 ? average : na, tenkan, kijun, full77 ? spanA[25] : na, full77 ? spanB[25] : na, close, time_close)

f_previous_context() =>
    Context state = f_context()
    state[1]

bool weekly = timeframe.isweekly and timeframe.multiplier == 1
bool tickView = timeframe.isticks
bool daily = timeframe.isdaily and timeframe.multiplier == 1
bool intraday = timeframe.isintraday
bool coarse = not tickView and (timeframe.isdaily and timeframe.multiplier > 1 or timeframe.isweekly and not weekly or timeframe.ismonthly)
bool nativeTf = weekly
string signalTf = "1W"
string chartName = timeframe.isminutes ? (timeframe.multiplier % 60 == 0 ? str.tostring(timeframe.multiplier / 60, "0") + "H" : str.tostring(timeframe.multiplier) + " MIN") : timeframe.period
string displaySymbol = syminfo.prefix + ":" + syminfo.ticker
if barstate.isfirst
    if not chart.is_standard
        runtime.error("Use standard candles, bars or a line chart. Synthetic prices do not represent executable market prices.")
    if fastLength >= slowLength
        runtime.error("KAMA fast length must be smaller than slow length.")

// Higher-timeframe requests contain previous CLOSED weekly values. The daily
// bridge contains only facts already known at the daily opening timestamp.
Towers asset = na
Towers btc = na
Towers weeklyPlot = na
if weekly
    Towers raw = f_engine()
    asset := barstate.isconfirmed ? raw : raw[1]
    weeklyPlot := raw[1]
    Towers reference = request.security(btcSymbol, "1W", f_engine(), lookahead = barmerge.lookahead_off, ignore_invalid_symbol = true)
    btc := btcSymbol == syminfo.tickerid ? asset : barstate.isconfirmed ? reference : reference[1]
else if not coarse
    asset := request.security(syminfo.tickerid, "1W", f_previous(), lookahead = barmerge.lookahead_on)
    btc := request.security(btcSymbol, "1W", f_previous(), lookahead = barmerge.lookahead_on, ignore_invalid_symbol = true)

array<DayRecord> packet = array.new<DayRecord>()
if weekly or coarse
    packet := request.security_lower_tf(syminfo.tickerid, "1D", f_day(), ignore_invalid_timeframe = true)
else
    DayRecord day = request.security(syminfo.tickerid, "1D", f_day(), lookahead = barmerge.lookahead_on)
    if not na(day)
        packet.push(day)

var ExampleBook book = ExampleBook.new(array.new<TradeExample>(), array.new_int(), array.new_float(), array.new_int())
// Preload this expression on the last confirmed historical bar. A request first
// encountered during a live gap cannot introduce a new dataset in Pine.
array<DayRecord> recovered = na
if not (weekly or coarse) and (barstate.islastconfirmedhistory or barstate.islast)
    recovered := request.security(syminfo.tickerid, "1D", f_day_tail(), lookahead = barmerge.lookahead_on)
// Recover a recent skipped publication on the active irregular/tick bar.
// The requested array exists ONLY on the last daily bar, avoiding historical
// copies on every candle. Earlier unavailable periods stay explicitly unpriced.
if not (weekly or coarse) and barstate.islast and packet.size() > 0
    DayRecord newest = packet.last()
    if not na(book.lastDay) and newest.at > book.lastDay + DAY_MS
        if not na(recovered)
            packet := recovered

var array<Towers> timeline = array.new<Towers>()
var array<int> timelineBuckets = array.new_int()
var array<label> actionBadges = array.new<label>()
var array<label> actionDots = array.new<label>()
var array<line> actionGuides = array.new<line>()
var array<int> badgeTimes = array.new_int()
var array<int> badgeKinds = array.new_int()
var array<float> badgeLines = array.new_float()
var array<float> badgeBands = array.new_float()
var array<label> warningDots = array.new<label>()
var array<line> warningGuides = array.new<line>()
var int lastDrawn = na
var int lastWarning = na
var Towers latestSource = na
// The viewport affects drawings only. The engine, ledger and alerts never use it.
int viewLeft = chart.left_visible_bar_time
int viewRight = chart.right_visible_bar_time
int viewSpan = math.max(1, viewRight - viewLeft)
bool latestInView = time >= viewLeft and time <= viewRight
var float viewHigh = na
var float viewLow = na
var int viewBars = 0
if latestInView
    viewBars += 1
    viewHigh := na(viewHigh) ? high : math.max(viewHigh, high)
    viewLow := na(viewLow) ? low : math.min(viewLow, low)
int asOf = barstate.isrealtime ? timenow : weekly or coarse ? math.min(time_close, timenow) : time
// An illiquid feed may load an open candle without a realtime update. Its
// scheduled close is still in the future; live freshness uses the actual clock.
// Replay's current weekly bar is unfinished even when its scheduled close is
// historical. Use its opening boundary, or the last available daily bridge
// opening on a coarse view; never use the real wall clock in historical mode.
if historicalReview
    asOf := weekly ? (barstate.isconfirmed ? time_close : time) : coarse and packet.size() > 0 ? packet.last().at : time
else if barstate.islast
    asOf := timenow

// Counts are observed conditions on a completed week, never probabilities.
f_below_band(Towers s) =>
    not na(s) and not na(s.line) and not na(s.atr) and s.price < s.line - atrBuffer * s.atr

f_check_tip(Towers s) =>
    string counts = na(s) or not s.ready ? "Waiting for valid weekly data." : bandExit ? "BUY: " + str.tostring(s.bullVotes) + " of 3 met · SELL: price " + (f_below_band(s) ? "below" : "at or above") + " the sell line" : "BUY: " + str.tostring(s.bullVotes) + " of 3 met · SELL: " + str.tostring(s.bearVotes) + " of 3 met"
    string rule = bandExit ? "\nA BUY needs all three conditions on " + str.tostring(confirmation) + " weekly " + (confirmation == 1 ? "close." : "closes in a row.") + "\nA SELL needs " + str.tostring(confirmation) + " weekly " + (confirmation == 1 ? "close" : "closes in a row") + " below\nthe sell line. The first is the warning." : "\nNeeds all 3 for " + str.tostring(confirmation) + " consecutive completed " + (confirmation == 1 ? "week." : "weeks.") + "\nPrice beyond buffer · trend slope · long term structure."
    counts + rule + "\nA checklist, not a probability."

f_warning_tip(Towers s) =>
    bandExit ? "WARNING · " + f_readable_date(s.confirmedAt) + " UTC\n\nThis week closed below the sell line.\nA SELL needs " + str.tostring(confirmation) + " weekly closes in a row below it,\nso the model keeps holding for now.\nA warning is not a SELL." : "WARNING · " + f_readable_date(s.confirmedAt) + " UTC\n\nThe model keeps holding, but " + str.tostring(s.bearVotes) + " of its 3\nSELL conditions are now met.\nA warning is not a SELL."

f_room_tip(Towers s, float priceValue, float edgeValue, int votes) =>
    na(votes) ? "Latest price: " + f_number(priceValue) + "\nSell line from the " + f_readable_date(s.confirmedAt) + " close: " + f_number(edgeValue) + "\nThe share is of the price: the fall that reaches the line.\nMeasured like the website. Context, not a signal." : "BUY conditions met at the " + f_readable_date(s.confirmedAt) + " close: " + str.tostring(votes) + " of 3\nA BUY needs all three on two weekly closes in a row.\nMeasured like the website. Context, not a signal."

// A warning sits on the weekly close that broke the sell line, with a hairline up to that line.
f_warning_marker(Towers s) =>
    warningDots.push(label.new(s.confirmedAt, s.price, "◇", xloc = xloc.bar_time, style = label.style_none, textcolor = gold, size = size.small, tooltip = f_warning_tip(s)))
    if warningDots.size() > 100
        label.delete(warningDots.shift())
    if not na(s.atr) and not na(s.line)
        warningGuides.push(line.new(s.confirmedAt, s.price, s.confirmedAt, s.line - atrBuffer * s.atr, xloc = xloc.bar_time, color = color.new(gold, 55), style = line.style_dotted))
        if warningGuides.size() > 40
            line.delete(warningGuides.shift())

// The dot, leader and pill of a confirmed BUY or SELL, anchored to the observed confirmation price, never the
// adaptive line. The pill stays hidden until clearance placement positions it on the last bar.
f_badge(Towers s) =>
    bool buy = s.bullEvent
    string title = buy ? "BUY" : "SELL"
    string tip = title + " CONFIRMED · " + f_readable_date(s.confirmedAt) + " UTC\n\n" + (buy ? "The model starts holding.\nThe trade stays open until a SELL confirms,\nso there is no result yet." : "The model moves to cash and waits for the next BUY.\nA result needs both a recorded entry\nand a recorded exit price.") + "\n\nThe date marks confirmation, not a deadline.\nIf you act later, your price and result will differ."
    actionGuides.push(line.new(s.confirmedAt, s.price, s.confirmedAt, s.price, xloc = xloc.bar_time, color = color.new(background, 100), style = line.style_dotted))
    actionDots.push(label.new(s.confirmedAt, s.price, "●", xloc = xloc.bar_time, style = label.style_none, textcolor = buy ? gold : sellDot, size = 12, tooltip = tip))
    actionBadges.push(label.new(s.confirmedAt, s.price, "", xloc = xloc.bar_time, style = label.style_label_down, color = color.new(background, 100), textcolor = buy ? buyInk : sellInk, size = badgeSize, text_formatting = text.format_bold, tooltip = tip))
    badgeTimes.push(s.confirmedAt)
    badgeKinds.push(buy ? 1 : -1)
    badgeLines.push(s.line)
    badgeBands.push(na(s.atr) ? na : atrBuffer * s.atr)
    if actionBadges.size() > 150
        label.delete(actionBadges.shift())
        label.delete(actionDots.shift())
        line.delete(actionGuides.shift())
        badgeTimes.shift()
        badgeKinds.shift()
        badgeLines.shift()
        badgeBands.shift()

// Each bridge item is an opening record. It can be used at that opening, even
// though the rest of the daily candle is still developing. No close leaks in.
if packet.size() > 0
    for item in packet
        if item.at <= asOf
            book.consume(item)
            Towers s = item.state
            if not na(s) and s.confirmedAt <= item.at and (na(latestSource) or s.confirmedAt > latestSource.confirmedAt)
                latestSource := s
                timeline.push(s)
                timelineBuckets.push(bar_index)
                if timeline.size() > 1500
                    timeline.shift()
                    timelineBuckets.shift()
                if s.ready and (s.bullEvent or s.bearEvent) and (na(lastDrawn) or s.confirmedAt > lastDrawn)
                    if showOverlay and showMarkers
                        f_badge(s)
                    lastDrawn := s.confirmedAt
                if s.ready and s.warnEvent and (na(lastWarning) or s.confirmedAt > lastWarning)
                    if showOverlay and showWarningMarkers
                        f_warning_marker(s)
                    lastWarning := s.confirmedAt
if coarse
    asset := latestSource
    // A DAILY previous-week BTC bridge avoids sampling a whole monthly candle.
    array<Towers> references = request.security_lower_tf(btcSymbol, "1D", request.security(btcSymbol, "1W", f_previous(), lookahead = barmerge.lookahead_on, ignore_invalid_symbol = true), ignore_invalid_timeframe = true, ignore_invalid_symbol = true)
    if references.size() > 0
        btc := references.last()

bool assetFresh = not na(asset) and asset.confirmedAt <= asOf and asOf - asset.confirmedAt < WEEK_MS
bool btcFresh = not na(btc) and btc.confirmedAt <= asOf and asOf - btc.confirmedAt < WEEK_MS
bool assetReady = assetFresh and asset.ready
bool btcReady = btcFresh and btc.ready
// Native weekly close is the alert/order event. Bridge records pair fills at the
// next open; badges can already appear on the close before that opening exists.
bool bull = weekly and barstate.isconfirmed and assetReady and asset.bullEvent
bool bear = weekly and barstate.isconfirmed and assetReady and asset.bearEvent
bool warning = weekly and barstate.isconfirmed and assetReady and asset.warnEvent
if (bull or bear) and (na(lastDrawn) or asset.confirmedAt > lastDrawn)
    if showOverlay and showMarkers
        f_badge(asset)
    lastDrawn := asset.confirmedAt
if warning and (na(lastWarning) or asset.confirmedAt > lastWarning)
    if showOverlay and showWarningMarkers
        f_warning_marker(asset)
    lastWarning := asset.confirmedAt

// The newest price against the reading, measured exactly as the website's member chart measures it from its latest
// dot. While the model holds, a bracket runs from the latest bar's price to the sell line, and the note reads
// "Sell line" over "12.0% lower": a share of the price, so exactly the fall that reaches the line, and "3.1% higher"
// under it, the rise back above it. While the model waits in cash there is no bracket: the buy line is one of three
// BUY conditions, so the note reads "BUY conditions" over "●●○ 2 of 3", as met at the last weekly close. Context,
// never a signal.
float roomEdge = assetReady and asset.regime == 1 and not na(asset.atr) ? asset.line - atrBuffer * asset.atr : na
float roomClose = assetReady ? close : na
float roomPct = not na(roomEdge) and roomEdge > 0 and roomClose > 0 ? 100 * (roomEdge / roomClose - 1) : na
int roomVotes = assetReady and asset.regime == -1 ? asset.bullVotes : na
// One decimal, as on the website: a price just past the line reads "0.3%", never "0%".
string roomAmount = na(roomPct) ? "Unavailable" : str.tostring(math.abs(roomPct), "0.0") + "% " + (roomPct < 0 ? "lower" : "higher")
string roomTitle = not na(roomPct) ? "Sell line" : "BUY conditions"
string roomValue = not na(roomPct) ? roomAmount : na(roomVotes) ? "Unavailable" : str.repeat("●", nz(roomVotes)) + str.repeat("○", 3 - nz(roomVotes)) + " " + str.tostring(roomVotes) + " of 3"
bool roomReady = not na(roomPct) or not na(roomVotes)
// Like the website, a bracket stands one bar right of the latest bar and the note reads to ITS right, in the
// empty space TradingView keeps there (10 bars by default). Nothing is drawn over past prices, the trend
// line or the corridor at any zoom. Pine exposes visible bars, not pixels, so the note width is estimated
// for a 1,300 px desktop pane. Extra empty space from scrolling only adds room. A note estimated wider than
// the default margin leaves its reading to the panel row; with no trend guide panel it still draws.
float roomBarMs = tickView ? math.max(1.0, float(nz(time - time[1], 1000))) : timeframe.in_seconds() * 1000.0
float roomNoteBars = (readingSize == "Compact" ? 72.0 : readingSize == "Large" ? 104.0 : 88.0) * (viewBars + 10) / 1300.0
bool roomNoteShown = 1.0 + roomNoteBars <= 9.0 or not (showPanel and panelView == "Trend guide")
var line roomGuide = na
var line roomTop = na
var line roomBottom = na
var label roomNote = na
var label roomFigure = na
if barstate.islast
    line.delete(roomGuide)
    line.delete(roomTop)
    line.delete(roomBottom)
    label.delete(roomNote)
    label.delete(roomFigure)
    if showOverlay and showRoom and latestInView and roomReady
        int bracketX = time + int(roomBarMs)
        float noteY = roomClose
        if not na(roomPct)
            // A measuring bracket from the latest price to the sell line, ticked at both ends.
            int tickLeft = bracketX - int(roomBarMs * 0.25)
            int tickRight = bracketX + int(roomBarMs * 0.25)
            color bracketInk = color.new(ink, 25)
            roomGuide := line.new(bracketX, roomClose, bracketX, roomEdge, xloc = xloc.bar_time, color = bracketInk, width = 1)
            roomTop := line.new(tickLeft, roomClose, tickRight, roomClose, xloc = xloc.bar_time, color = bracketInk, width = 1)
            roomBottom := line.new(tickLeft, roomEdge, tickRight, roomEdge, xloc = xloc.bar_time, color = bracketInk, width = 1)
            noteY := math.sqrt(roomClose * roomEdge)
        if roomNoteShown
            // Two lines like the website's note: the line's name small and muted, the figure bold under it. Both start
            // at the bracket and extend RIGHT, into the empty margin only; the name hangs above the anchor, the figure
            // below it, and each box in the canvas colour keeps its text legible over a line.
            string roomTip = f_room_tip(asset, roomClose, roomEdge, roomVotes)
            roomNote := label.new(bracketX, noteY, roomTitle, xloc = xloc.bar_time, style = label.style_label_lower_left, color = color.new(background, 12), textcolor = neutral, size = bodySize - 2, tooltip = roomTip)
            roomFigure := label.new(bracketX, noteY, roomValue, xloc = xloc.bar_time, style = label.style_label_upper_left, color = color.new(background, 12), textcolor = ink, size = bodySize, text_formatting = text.format_bold, tooltip = roomTip)

// Update completed-pair metadata only after the exit opening record exists.
// Replay before SELL cannot access a later result. No signal/date is rewritten.
if barstate.islast and actionBadges.size() > 0
    for i = 0 to actionBadges.size() - 1
        int stamp = badgeTimes.get(i)
        int kind = badgeKinds.get(i)
        bool found = false
        if book.pairs.size() > 0
            for pair in book.pairs
                if (kind == 1 ? pair.buyAt : pair.sellAt) == stamp
                    string tip = f_trade_tip(pair)
                    label.set_tooltip(actionBadges.get(i), tip)
                    label.set_tooltip(actionDots.get(i), tip)
                    found := true
                    break
        if not found and kind == 1 and (na(book.entryAt) or book.entryAt != stamp) and stamp < asOf
            string tip = "BUY · " + f_readable_date(stamp) + " UTC\n\nProfit / loss unavailable.\nA recorded entry or exit price is missing.\nSwitch to 1W for more history."
            label.set_tooltip(actionBadges.get(i), tip)
            label.set_tooltip(actionDots.get(i), tip)

// A custom intraday/tick bar can straddle confirmation. Its scalar plot must
// represent information known at its OPEN on both live bars and reload. The
// timestamped badge and panel can already report the newly confirmed event.
Towers displayState = weekly ? weeklyPlot : not coarse and not na(asset) and asset.confirmedAt > time ? asset[1] : asset
int displayAt = not weekly and not coarse ? time : asOf
bool displayFresh = not na(displayState) and displayState.confirmedAt <= displayAt and displayAt - displayState.confirmedAt <= WEEK_MS
bool displayReady = displayFresh and displayState.ready
float visibleLine = showOverlay and not coarse and displayFresh ? displayState.line : na
color displayColor = not displayReady or displayState.regime == 0 ? neutral : displayState.regime == 1 ? gold : bearColor
Towers priorDisplay = displayState[1]
color segmentColor = not displayReady or na(priorDisplay) or not priorDisplay.ready ? neutral : priorDisplay.regime == 1 ? gold : priorDisplay.regime == -1 ? bearColor : neutral
// The corridor on native intervals: line ± the ATR buffer, the band every weekly close is judged against.
// Its lower edge is the sell line while gold and its upper edge the buy line while grey; only that edge shows.
float visibleUpper = showOverlay and not coarse and displayReady and displayState.regime != 0 and not na(displayState.atr) ? displayState.line + atrBuffer * displayState.atr : na
float visibleLower = showOverlay and not coarse and displayReady and displayState.regime != 0 and not na(displayState.atr) ? displayState.line - atrBuffer * displayState.atr : na
int upperTransparency = not na(priorDisplay) and priorDisplay.regime == -1 ? 25 : 100
int lowerTransparency = not na(priorDisplay) and priorDisplay.regime == 1 ? 25 : 100
upperPlot = plot(visibleUpper, "Buy line", color = color.new(segmentColor, upperTransparency), linewidth = 1, style = plot.style_linebr, linestyle = plot.linestyle_dashed, editable = false, display = display.pane)
lowerPlot = plot(visibleLower, "Sell line", color = color.new(segmentColor, lowerTransparency), linewidth = 1, style = plot.style_linebr, linestyle = plot.linestyle_dashed, editable = false, display = display.pane)
fill(upperPlot, lowerPlot, color = color.new(segmentColor, 93), title = "Corridor", fillgaps = false)
trendPlot = plot(visibleLine, "Trend line", color = segmentColor, linewidth = 3, style = plot.style_linebr, display = display.pane + display.price_scale)
// At a chart opening, only the previous close is known. Do not backdate the
// current close or join a missing interval. This is price context, not model input.
float completedChartPrice = weekly ? (not na(displayState) ? displayState.price : na) : time == time_close[1] ? close[1] : na
float ribbonPrice = showOverlay and not coarse and displayReady and displayState.regime != 0 ? completedChartPrice : na
pricePlot = plot(ribbonPrice, "Price path", color = color.new(neutral, 25), linewidth = 1, style = plot.style_linebr, display = display.pane)
fill(pricePlot, trendPlot, color = showRibbon ? color.new(segmentColor, ribbonTransparency) : na, title = "Ribbon", fillgaps = false)
bgcolor(showOverlay and showRegimeWash and displayReady and displayState.regime != 0 ? color.new(displayColor, washTransparency) : na, title = "Background tint")

// Native monthly candles can snap several weekly timestamps to one column.
// Keep event anchors and gaps, thinning redundant non-event points per chart bar.
// Every retained value and timestamp is an actual weekly observation.
type CurveKnot
    Towers state
    int bucket
    bool gapBefore

f_curve_knots() =>
    array<CurveKnot> result = array.new<CurveKnot>()
    Towers previousRaw = na
    if timeline.size() > 0
        for i = 0 to timeline.size() - 1
            Towers s = timeline.get(i)
            int bucket = timelineBuckets.get(i)
            bool gap = not na(previousRaw) and (s.confirmedAt != previousRaw.confirmedAt + WEEK_MS or (not previousRaw.ready and previousRaw.validBars >= wWarmup) or (not s.ready and s.validBars >= wWarmup))
            CurveKnot last = result.size() > 0 ? result.last() : na
            bool sameRun = not na(last) and last.state.ready == s.ready and last.state.regime == s.regime
            bool anchor = s.ready and (s.bullEvent or s.bearEvent or s.warnEvent)
            bool lastAnchor = not na(last) and last.state.ready and (last.state.bullEvent or last.state.bearEvent or last.state.warnEvent)
            bool bucketEnd = i == timeline.size() - 1 or timelineBuckets.get(i + 1) != bucket
            bool replaceableTurn = anchor and not lastAnchor and not na(last) and last.state.ready == s.ready
            if not everyWeeklyPoint and not gap and not na(last) and last.bucket == bucket and (sameRun or replaceableTurn)
                if not lastAnchor
                    result.set(result.size() - 1, CurveKnot.new(s, bucket, last.gapBefore))
                else if anchor or bucketEnd
                    result.push(CurveKnot.new(s, bucket, false))
            else
                result.push(CurveKnot.new(s, bucket, gap))
            previousRaw := s
    result

var array<polyline> curves = array.new<polyline>()
type CurveRun
    array<chart.point> edge
    array<chart.point> prices
    array<chart.point> lower
    array<chart.point> upper
    int regime

f_curve_point(CurveRun target, Towers s, int stamp) =>
    target.edge.push(chart.point.from_time(stamp, s.line))
    target.prices.push(chart.point.from_time(stamp, s.price))
    target.lower.push(chart.point.from_time(stamp, s.line - atrBuffer * s.atr))
    target.upper.push(chart.point.from_time(stamp, s.line + atrBuffer * s.atr))

f_keep_run(array<CurveRun> runs, CurveRun current) =>
    if current.edge.size() > 1 and current.edge.last().time >= viewLeft and current.edge.first().time <= viewRight + int(timeframe.in_seconds() * 1000)
        runs.push(current)

f_polygon(array<chart.point> top, array<chart.point> bottom, color tint) =>
    array<chart.point> points = top.copy()
    for j = bottom.size() - 1 to 0
        points.push(bottom.get(j))
    curves.push(polyline.new(points, closed = true, xloc = xloc.bar_time, line_color = color.new(tint, 100), fill_color = tint))

bool reducedDecoration = false
if barstate.islast and coarse and showOverlay
    for drawing in curves
        polyline.delete(drawing)
    curves.clear()
    array<CurveRun> runs = array.new<CurveRun>()
    CurveRun current = CurveRun.new(array.new<chart.point>(), array.new<chart.point>(), array.new<chart.point>(), array.new<chart.point>(), 0)
    int run = 0
    Towers previous = na
    array<CurveKnot> knots = f_curve_knots()
    if knots.size() > 0
        for knot in knots
            Towers s = knot.state
            int nextRun = s.ready ? s.regime : 0
            bool gap = knot.gapBefore or na(s.atr) or (not na(previous) and na(previous.atr))
            if not na(previous) and not na(s.line) and not gap
                f_curve_point(current, s, s.confirmedAt)
            if na(previous) or nextRun != run or gap
                f_keep_run(runs, current)
                current := CurveRun.new(array.new<chart.point>(), array.new<chart.point>(), array.new<chart.point>(), array.new<chart.point>(), nextRun)
                run := nextRun
            if current.edge.size() == 0 and not na(s.line)
                f_curve_point(current, s, s.confirmedAt)
            previous := s
        if not na(previous) and asOf > previous.confirmedAt and asOf - previous.confirmedAt < WEEK_MS
            f_curve_point(current, previous, asOf)
        f_keep_run(runs, current)
    // Reserve the core trend, active edge and price first. Remaining slots go to
    // the newest fills. No FIFO eviction can silently remove the visible trend.
    int coreCount = 0
    for segment in runs
        coreCount += segment.regime == 0 ? 2 : 3
    int spare = math.max(0, 98 - coreCount)
    if runs.size() > 0
        for i = runs.size() - 1 to 0
            CurveRun segment = runs.get(i)
            color tint = segment.regime == 1 ? gold : segment.regime == -1 ? bearColor : neutral
            if segment.regime != 0
                if spare > 0
                    f_polygon(segment.upper, segment.lower, color.new(tint, 93))
                    spare -= 1
                else
                    reducedDecoration := true
                if showRibbon and spare > 0
                    f_polygon(segment.edge, segment.prices, color.new(tint, ribbonTransparency))
                    spare -= 1
                else if showRibbon
                    reducedDecoration := true
        for layer = 0 to 2
            for i = runs.size() - 1 to 0
                CurveRun segment = runs.get(i)
                color tint = segment.regime == 1 ? gold : segment.regime == -1 ? bearColor : neutral
                if layer != 1 or segment.regime != 0
                    if curves.size() < 98
                        if layer == 0
                            curves.push(polyline.new(segment.edge, curved = false, xloc = xloc.bar_time, line_color = tint, line_width = 3))
                        else if layer == 1
                            curves.push(polyline.new(segment.regime == 1 ? segment.lower : segment.upper, xloc = xloc.bar_time, line_color = color.new(tint, 30), line_style = line.style_dashed, line_width = 1))
                        else
                            curves.push(polyline.new(segment.prices, xloc = xloc.bar_time, line_color = color.new(neutral, 25), line_width = 1))
                    else
                        reducedDecoration := true

// Settings select a completed pair on the native chart. These drawings use only
// already recorded prices. Pine cannot change the user's visible time range.
var polyline reviewedPrice = na
var label reviewedBuy = na
var label reviewedSell = na
if barstate.islast
    polyline.delete(reviewedPrice)
    label.delete(reviewedBuy)
    label.delete(reviewedSell)
    if showOverlay and showPanel and panelView == "Trade calculator" and book.pairs.size() >= exampleNumber
        TradeExample selected = book.pairs.get(book.pairs.size() - exampleNumber)
        array<chart.point> observed = array.new<chart.point>()
        int previousAt = na
        bool completePath = true
        for s in timeline
            if s.confirmedAt >= selected.buyAt and s.confirmedAt <= selected.sellAt
                completePath := completePath and s.ready and (na(previousAt) ? s.confirmedAt == selected.buyAt : s.confirmedAt == previousAt + WEEK_MS)
                observed.push(chart.point.from_time(s.confirmedAt, s.price))
                previousAt := s.confirmedAt
        if completePath and previousAt == selected.sellAt and observed.size() > 1
            reviewedPrice := polyline.new(observed, xloc = xloc.bar_time, line_color = ink, line_width = 3)
        reviewedBuy := label.new(selected.buyAt, selected.buyOpen * (1 + exampleSlippage / 100), "○", xloc = xloc.bar_time, style = label.style_none, textcolor = ink, size = size.large, tooltip = "Modeled BUY fill before fees\n" + f_trade_tip(selected))
        reviewedSell := label.new(selected.sellAt, selected.sellOpen * (1 - exampleSlippage / 100), "○", xloc = xloc.bar_time, style = label.style_none, textcolor = ink, size = size.large, tooltip = "Modeled SELL fill before fees\n" + f_trade_tip(selected))

Context context = request.security(syminfo.tickerid, "1D", f_previous_context(), lookahead = barmerge.lookahead_on)
bool contextFresh = showOverlay and not coarse and not na(context) and context.confirmedAt <= asOf and asOf - context.confirmedAt <= DAY_MS
bool averageReady = contextFresh and not na(context.average)
bool cloudReady = contextFresh and not na(context.cloudA) and not na(context.cloudB)
plot(showSma and averageReady ? context.average : na, "200-day SMA · confirmed", color = neutral, display = display.pane)
plot(showCloud and contextFresh ? context.tenkan : na, "Daily Tenkan", color = gold, display = display.pane)
plot(showCloud and contextFresh ? context.kijun : na, "Daily Kijun", color = neutral, display = display.pane)
cloud1 = plot(showCloud and cloudReady ? context.cloudA : na, "Daily span A", color = color.new(gold, 65), display = display.pane)
cloud2 = plot(showCloud and cloudReady ? context.cloudB : na, "Daily span B", color = color.new(neutral, 65), display = display.pane)
fill(cloud1, cloud2, color = color.new(neutral, 90), title = "Confirmed daily cloud")

f_higher(float a, float b) =>
    na(a) ? b : na(b) ? a : math.max(a, b)

f_lower(float a, float b) =>
    na(a) ? b : na(b) ? a : math.min(a, b)

// What every bar in view draws, for badge placement: its candle, and the plotted line, corridor, price ribbon
// and daily context. Plotted lines join neighbouring bars, so placement spreads those one bar each side.
var array<int> sceneTimes = array.new_int()
var array<float> sceneHighs = array.new_float()
var array<float> sceneLows = array.new_float()
var array<float> scenePlotHighs = array.new_float()
var array<float> scenePlotLows = array.new_float()
if showOverlay and showMarkers and latestInView
    float average = showSma and averageReady ? context.average : na
    float tenkan = showCloud and contextFresh ? context.tenkan : na
    float kijun = showCloud and contextFresh ? context.kijun : na
    float spanA = showCloud and cloudReady ? context.cloudA : na
    float spanB = showCloud and cloudReady ? context.cloudB : na
    sceneTimes.push(time)
    sceneHighs.push(high)
    sceneLows.push(low)
    scenePlotHighs.push(f_higher(f_higher(f_higher(visibleUpper, visibleLine), f_higher(ribbonPrice, visibleLower)), f_higher(f_higher(average, tenkan), f_higher(kijun, f_higher(spanA, spanB)))))
    scenePlotLows.push(f_lower(f_lower(f_lower(visibleLower, visibleLine), f_lower(ribbonPrice, visibleUpper)), f_lower(f_lower(average, tenkan), f_lower(kijun, f_lower(spanA, spanB)))))

bool frozenDefaults = fastLength == 2 and slowLength == 30 and atrBuffer == 0.5 and confirmation == 2 and wErLength == 10 and wEmaLength == 40 and wAtrLength == 14 and wKamaSlope == 2 and wEmaSlope == 4 and wWarmup == 52
plot(assetFresh ? asset.line : na, "Three Towers Trend Line", display = display.data_window)
plot(assetReady ? asset.regime : na, "TT Regime", display = display.data_window)
plot(assetReady ? (asset.weakening ? 1 : 0) : na, "TT Weakening", display = display.data_window)
plot(assetFresh ? asset.ema : na, "TT EMA", display = display.data_window)
plot(assetFresh ? asset.atr : na, "TT ATR", display = display.data_window)
plot(assetFresh ? asset.confirmedAt / 1000 : na, "TT Confirmed UTC seconds", display = display.data_window)
plot(bull ? 1 : bear ? -1 : warning ? 2 : 0, "TT Event", display = display.data_window)
plot(assetFresh ? asset.firstSourceAt / 1000 : na, "TT First source UTC seconds", display = display.data_window)
plot(assetFresh ? asset.validBars : na, "TT Valid bars", display = display.data_window)
plot(assetReady ? 1 : 0, "TT Ready", display = display.data_window)
plot(1, "TT Model", display = display.data_window)
plot(frozenDefaults ? 1 : 0, "TT Defaults", display = display.data_window)
plot(bandExit ? 1 : 0, "TT SELL rule (1 = below the sell line, 0 = 1.4 classic)", display = display.data_window)
plot(displayFresh ? displayState.confirmedAt / 1000 : na, "TT Display UTC seconds", display = display.data_window)
plot(displayReady ? displayState.regime : na, "TT Display regime", display = display.data_window)
plot(displayReady ? displayState.bullVotes : na, "BUY conditions met (of 3)", display = display.data_window)
plot(displayReady ? displayState.bearVotes : na, "SELL conditions met (of 3)", display = display.data_window)

// Tables do not wrap themselves. Bound even unknown tickers and exact UTC times.
f_wrap(string value, int limit) =>
    string result = ""
    for paragraph in str.split(value, "\n")
        string current = ""
        for word in str.split(paragraph, " ")
            if str.length(current) + str.length(word) + 1 > limit and current != ""
                result += (result == "" ? "" : "\n") + current
                current := ""
            string rest = word
            while str.length(rest) > limit
                result += (result == "" ? "" : "\n") + str.substring(rest, 0, limit)
                rest := str.substring(rest, limit)
            current += (current == "" ? "" : " ") + rest
        result += (result == "" or current == "" ? "" : "\n") + current
    result

f_short_number(float value) =>
    float magnitude = math.abs(value)
    na(value) ? "Unavailable" : magnitude >= 1e12 ? str.tostring(value / 1e12, "0.##") + "T" : magnitude >= 1e9 ? str.tostring(value / 1e9, "0.##") + "B" : magnitude >= 1e6 ? str.tostring(value / 1e6, "0.##") + "M" : f_number(value)

// The status panel's size as it is built, so signal pills can keep clear of it: the widest heading, value and
// full row, and the total height, in px. Fitted to the 1.6.1 panel on an 804 px pane (153 px tall, 121 px of it
// rows): table text is about half its size wide per character, and a row is 1.2 lines of text plus 4 px.
var array<float> panelSize = array.new_float(4, 0.0)

f_longest(string value) =>
    array<string> lines = str.split(value, "\n")
    int longest = 0
    for part in lines
        longest := math.max(longest, str.length(part))
    [longest, lines.size()]

f_row(table target, int row, string heading, string value, color tint) =>
    string left = f_wrap(heading, readingSize == "Large" ? 17 : 20)
    string right = f_wrap(value, readingSize == "Large" ? 18 : 22)
    table.cell(target, 0, row, left, bgcolor = background, text_color = neutral, text_size = bodySize, text_halign = text.align_left)
    table.cell(target, 1, row, right, bgcolor = background, text_color = tint, text_size = bodySize, text_halign = text.align_right, tooltip = value)
    [leftLongest, leftLines] = f_longest(left)
    [rightLongest, rightLines] = f_longest(right)
    panelSize.set(0, math.max(panelSize.get(0), leftLongest * bodySize * 0.5 + 8))
    panelSize.set(1, math.max(panelSize.get(1), rightLongest * bodySize * 0.5 + 8))
    panelSize.set(3, panelSize.get(3) + math.max(leftLines, rightLines) * bodySize * 1.2 + 4)

f_full(table target, int row, string value, color tint, bool hero = false, string tip = "") =>
    string body = f_wrap(value, readingSize == "Large" ? 30 : 36)
    table.merge_cells(target, 0, row, 1, row)
    table.cell(target, 0, row, body, bgcolor = background, text_color = tint, text_size = hero ? heroSize : bodySize, text_halign = text.align_left, text_formatting = hero ? text.format_bold : text.format_none, tooltip = tip)
    [longest, lines] = f_longest(body)
    int textSize = hero ? heroSize : bodySize
    panelSize.set(2, math.max(panelSize.get(2), longest * textSize * 0.52 + 8))
    panelSize.set(3, panelSize.get(3) + lines * textSize * 1.2 + 4)

string assetName = switch syminfo.basecurrency
    "BTC" => "Bitcoin"
    "ETH" => "Ethereum"
    "SOL" => "Solana"
    "XRP" => "XRP"
    "DOGE" => "Dogecoin"
    "ADA" => "Cardano"
    "AVAX" => "Avalanche"
    "LINK" => "Chainlink"
    "LTC" => "Litecoin"
    "BCH" => "Bitcoin Cash"
    => syminfo.ticker
// The website board reads every one of its ten coins from Bitstamp USD. Another feed gives other Monday closes.
string websiteFeed = switch syminfo.basecurrency
    "BTC" => "BITSTAMP:BTCUSD"
    "ETH" => "BITSTAMP:ETHUSD"
    "SOL" => "BITSTAMP:SOLUSD"
    "XRP" => "BITSTAMP:XRPUSD"
    "DOGE" => "BITSTAMP:DOGEUSD"
    "ADA" => "BITSTAMP:ADAUSD"
    "AVAX" => "BITSTAMP:AVAXUSD"
    "LINK" => "BITSTAMP:LINKUSD"
    "LTC" => "BITSTAMP:LTCUSD"
    "BCH" => "BITSTAMP:BCHUSD"
    => ""
string feedNote = websiteFeed == "" ? "Not on the website" : displaySymbol == websiteFeed ? "Same as the website" : "Website uses " + websiteFeed
string assetLabel = switch displaySymbol
    "PULSEX:WPLSDAI_E56043.USD" => "PLS (WPLS proxy)"
    "PULSEX:PLSXWPLS_1B45B9.USD" => "PLSX"
    "PULSEX:HEXWPLS_F1F4EE.USD" => "Native pHEX"
    => assetName
string panelPosition = switch panelCorner
    "Top right" => position.top_right
    "Top left" => position.top_left
    "Bottom left" => position.bottom_left
    => position.bottom_right
bool calculatorView = panelView == "Trade calculator"
bool historyView = panelView == "Previous trades"
var table panel = na
// Create only populated rows on the final execution. This also removes the
// empty frame formerly left by the strategy on an unfinished realtime week.
if barstate.islast
    table.delete(panel)
    if showOverlay and showPanel
        panel := table.new(panelPosition, 2, 32)
        panelSize.fill(0.0)
        int row = 0
        // Leave the native symbol/price header clear, including split panes.
        // Only populated cells have a background; this spacer is transparent.
        if str.contains(panelCorner, "Top")
            table.merge_cells(panel, 0, row, 1, row)
            table.cell(panel, 0, row, "", height = 4)
            row += 1
        bool stale = not historicalReview and (na(asset) or timenow - asset.confirmedAt >= WEEK_MS)
        bool usable = assetReady and not stale
        string identity = displaySymbol + "\nFeed: " + feedNote + "\nPlugin " + PLUGIN_VERSION + " · model " + (bandExit ? "weekly-1.5.0" : "weekly-1.0.0") + "\nBuild " + BUILD_ID + "\nThe same weekly model on every chart interval."
        if historyView
            int count = book.pairs.size()
            int pages = math.max(1, int(math.ceil(float(count) / tradesPerPage)))
            int page = math.min(tradePage, pages)
            int profitable = 0
            int losing = 0
            for pair in book.pairs
                float net = f_trade_return(pair)
                profitable += net > 0 ? 1 : 0
                losing += net < 0 ? 1 : 0
            f_full(panel, row, assetLabel + " · Previous trades", ink, true, identity)
            row += 1
            f_full(panel, row, str.tostring(profitable) + " profitable · " + str.tostring(losing) + " losing", neutral)
            row += 1
            if count == 0
                f_full(panel, row, "No completed trade in this view. Try 1W for more history.", neutral)
                row += 1
            else
                f_row(panel, row, "BUY → SELL · UTC", "After costs", neutral)
                row += 1
                for index = 0 to tradesPerPage - 1
                    int at = count - 1 - ((page - 1) * tradesPerPage + index)
                    if at >= 0
                        TradeExample pair = book.pairs.get(at)
                        string dates = str.format_time(pair.buyAt, "d MMM yy", "UTC") + " → " + str.format_time(pair.sellAt, "d MMM yy", "UTC")
                        f_row(panel, row, dates, f_percent(f_trade_return(pair)), ink)
                        table.cell_set_tooltip(panel, 0, row, f_trade_tip(pair))
                        table.cell_set_tooltip(panel, 1, row, f_trade_tip(pair))
                        row += 1
            f_full(panel, row, "Page " + str.tostring(page) + " of " + str.tostring(pages) + " · " + str.tostring(count) + " completed" + (not na(book.entryAt) ? " · 1 open" : ""), neutral)
            row += 1
            f_full(panel, row, "Historical simulation. Change page in Settings.", neutral, false, "Hover either date or return for recorded prices and costs.\nMissing executions are not assigned a return.\nUnpriced pairs: " + str.tostring(book.incomplete))
            row += 1
        else if not calculatorView
            int requiredWeeks = math.max(wWarmup, math.max(wEmaLength, wAtrLength))
            bool building = assetFresh and not stale and asset.validBars < requiredWeeks
            bool recovering = assetFresh and not stale and not asset.ready and not building
            string stance = building ? "Building history" : recovering ? "Waiting for valid weeks" : not usable ? "Reading unavailable" : asset.regime == 0 ? "Awaiting first signal" : asset.regime == 1 ? "Uptrend" : "Downtrend"
            string guide = building ? str.tostring(asset.validBars) + " of at least " + str.tostring(requiredWeeks) + " valid weeks loaded." : recovering ? "A gap interrupted the weekly record. Waiting for valid history." : not usable ? "The latest weekly reading is unavailable. No new signal." : asset.regime == 0 ? "Waiting for the first confirmed BUY or SELL." : reader == "I'm considering buying" ? (asset.regime == 1 ? "The model is holding. A purchase today uses today's price." : "The model waits for a confirmed BUY.") : ""
            f_full(panel, row, assetLabel + " · " + stance, usable and asset.regime == 1 ? gold : ink, true, identity)
            row += 1
            string lastSignal = not na(asset) and not na(asset.lastFlipAt) ? (asset.regime == 1 ? "BUY · " : "SELL · ") + f_readable_date(asset.lastFlipAt) : "None yet"
            f_row(panel, row, usable and asset.regime != 0 ? (asset.regime == 1 ? "Model holding" : "Model in cash") : "Last known signal", lastSignal, ink)
            string signalTip = not na(asset) and not na(asset.lastFlipAt) ? "Confirmed " + f_confirmation_time(asset.lastFlipAt) + " UTC.\nSignal age: " + str.tostring(math.max(0, int((asOf - asset.lastFlipAt) / DAY_MS))) + " days." : "No confirmed signal in the loaded history."
            table.cell_set_tooltip(panel, 1, row, signalTip + "\nThe model's position, not your wallet.\nAn old signal is not a new order.")
            row += 1
            f_row(panel, row, "Weekly confirmed", not na(asset) ? f_readable_date(asset.confirmedAt) : "Unavailable", usable ? neutral : gold)
            row += 1
            if usable and asset.weakening
                f_full(panel, row, "◇ Warning · not a SELL", gold, false, f_warning_tip(asset))
                row += 1
                f_full(panel, row, bandExit ? "Weekly close below the sell line. The model is still holding." : "The trend is weakening. The model is still holding.", ink)
                row += 1
            if guide != ""
                f_full(panel, row, guide, usable ? neutral : gold)
                row += 1
            if showRoom and roomReady
                f_row(panel, row, roomTitle, roomValue, ink)
                table.cell_set_tooltip(panel, 1, row, f_room_tip(asset, roomClose, roomEdge, roomVotes) + "\n" + (latestInView ? (roomNoteShown ? "Shown right of the latest bar." : "Zoom in to show the note beside the latest bar.") : "You are browsing older prices. This row is the latest reading."))
                row += 1
            if detailedPanel
                f_full(panel, row, "Reading details", ink, true)
                row += 1
                f_row(panel, row, "Bitcoin", btcReady ? (btc.regime == 1 ? "Uptrend" : btc.regime == -1 ? "Downtrend" : "Unclassified") : "Unavailable", btcReady and btc.regime == 1 ? gold : neutral)
                table.cell_set_tooltip(panel, 1, row, btcSymbol + "\nIndependent context. It never changes this coin's colour.\nConfirmed: " + (not na(btc) ? f_readable_date(btc.confirmedAt) : "Unavailable"))
                row += 1
                f_row(panel, row, "Next reading", usable ? f_readable_date(asset.confirmedAt + WEEK_MS) : "Unavailable", neutral)
                table.cell_set_tooltip(panel, 1, row, usable ? f_confirmation_time(asset.confirmedAt + WEEK_MS) + " UTC\nThe next weekly close the model reads.\nNot a forecast of a signal." : "The latest weekly reading is unavailable.")
                row += 1
                string checklist = not usable ? "Unavailable" : asset.regime == 0 ? "Awaiting first signal" : asset.regime == 1 and bandExit ? (f_below_band(asset) ? "Below sell line" : "At or above sell line") : str.tostring(asset.regime == 1 ? asset.bearVotes : asset.bullVotes) + " of 3 met"
                f_row(panel, row, usable and asset.regime != 0 ? (asset.regime == 1 ? "SELL checklist" : "BUY checklist") : "Checklist", checklist, neutral)
                table.cell_set_tooltip(panel, 1, row, f_check_tip(asset))
                row += 1
                string age = not na(asset) and not na(asset.lastFlipAt) ? str.tostring(math.max(0, int((asOf - asset.lastFlipAt) / DAY_MS))) + " days" : "Unavailable"
                f_row(panel, row, "Signal age", age, neutral)
                row += 1
                f_row(panel, row, "Loaded history", (not na(asset) ? str.tostring(asset.validBars) : "0") + " weeks", neutral)
                table.cell_set_tooltip(panel, 1, row, str.tostring(book.days.size()) + " daily opening records.\n" + str.tostring(book.pairs.size()) + " completed pairs.\n" + str.tostring(book.incomplete) + " unpriced pairs.\nConfirmation: " + str.tostring(confirmation) + " qualifying weeks in a row.\nSELL rule: " + exitRuleName)
                row += 1
                f_row(panel, row, "Feed", displaySymbol, neutral)
                table.cell_set_tooltip(panel, 1, row, identity)
                row += 1
            f_full(panel, row, "Gold: holding · Grey: in cash\n◇ Warning · Dashed: sell line or buy line", neutral, false, "BUY and SELL dots mark their exact confirmation price.\nHover a dot or label for its date and trade details.\nLabels make room when the chart is crowded.\nUse Settings > Previous trades or Trade calculator for details.")
            row += 1
        else
            TradeExample pair = book.pairs.size() >= exampleNumber ? book.pairs.get(book.pairs.size() - exampleNumber) : na
            [delayCost, delayProceeds] = f_delay(book, pair, entryDelay, exitDelay)
            bool staged = comparisonMode == "10% staging · experimental"
            bool delayed = comparisonMode == "Later execution"
            float unitCost = na(pair) ? na : delayed ? delayCost : pair.unitCost
            float unitProceeds = na(pair) ? na : delayed ? delayProceeds : staged ? pair.unitCost * pair.stagedFactor : pair.unitProceeds
            float netReturn = na(unitCost) or na(unitProceeds) ? na : 100 * (unitProceeds / unitCost - 1)
            float startingCapital = not na(pair) ? pair.unitCost * exampleQuantity : na
            float pnl = netReturn / 100 * startingCapital
            f_full(panel, row, assetLabel + " · Trade calculator", ink, true, identity)
            row += 1
            f_full(panel, row, staged ? "10% staging · experimental" : delayed ? "Later execution" : "Baseline · completed trade", neutral)
            row += 1
            f_full(panel, row, na(netReturn) ? "Result unavailable" : f_percent(netReturn) + " after costs", not na(netReturn) and netReturn >= 0 ? gold : ink, true)
            row += 1
            f_row(panel, row, "Profit / loss", f_short_number(pnl) + (na(pnl) ? "" : " " + syminfo.currency), ink)
            table.cell_set_tooltip(panel, 1, row, na(pnl) ? "A recorded entry or exit price is missing." : f_number(pnl) + " " + syminfo.currency)
            row += 1
            f_row(panel, row, (staged or delayed) ? "Same starting cash" : "Example quantity", (staged or delayed) ? f_short_number(startingCapital) + (na(startingCapital) ? "" : " " + syminfo.currency) : f_short_number(exampleQuantity) + " " + f_example_asset(), ink)
            table.cell_set_tooltip(panel, 1, row, (staged or delayed) ? f_number(startingCapital) + " " + syminfo.currency : f_quantity())
            row += 1
            f_row(panel, row, "BUY confirmed", not na(pair) ? f_readable_date(pair.buyAt) : "Unavailable", ink)
            row += 1
            f_row(panel, row, "SELL confirmed", not na(pair) ? f_readable_date(pair.sellAt) : "Unavailable", ink)
            row += 1
            f_row(panel, row, staged ? "Purchases / trims" : "Delay · buy / sell", staged ? (not na(pair) ? str.tostring(pair.purchases) + " / " + str.tostring(pair.trims) : "Unavailable") : str.tostring(delayed ? entryDelay : 0) + "d / " + str.tostring(delayed ? exitDelay : 0) + "d", neutral)
            row += 1
            f_row(panel, row, "Baseline result", f_percent(f_trade_return(pair)), neutral)
            row += 1
            f_row(panel, row, "Completed example", str.tostring(exampleNumber) + " / " + str.tostring(book.pairs.size()), neutral)
            row += 1
            if staged
                f_row(panel, row, "Current staging", na(book.entryAt) ? "No open example" : not book.stageValid ? "Unpriced" : book.stageFrozen ? "Buying stopped" : str.tostring(book.purchases) + " of 10 buys", neutral)
                row += 1
            f_full(panel, row, "Historical simulation\n0.3% fee + " + str.tostring(exampleSlippage, "0.0") + "% slippage per side", neutral, false, na(pair) ? "No completed pair in loaded history. Try 1W for more data." : f_trade_tip(pair))
            row += 1
            f_full(panel, row, "Change quantity, trade or delays in Settings.", neutral, false, "Losing baseline pairs: " + str.tostring(book.losing) + "\nUnpriced pairs: " + str.tostring(book.incomplete) + "\nLater execution and staging can improve or worsen the result.")
            row += 1
        if websiteFeed != "" and displaySymbol != websiteFeed
            f_full(panel, row, "Different feed\nWebsite: " + websiteFeed, gold, false, identity)
            row += 1
        else if websiteFeed == ""
            f_full(panel, row, "This feed is not on the website.", neutral, false, identity)
            row += 1
        if historicalReview or not frozenDefaults or not bandExit
            f_full(panel, row, (historicalReview ? "Historical review" : "") + (historicalReview and (not frozenDefaults or not bandExit) ? " · " : "") + (not frozenDefaults ? "Custom parameters" : not bandExit ? "Classic 1.4 model" : ""), gold, false, identity)
            row += 1
        if reducedDecoration
            f_full(panel, row, "Wide overview. Zoom in for full chart detail.", neutral)
            row += 1
        if str.contains(panelCorner, "Bottom")
            f_full(panel, row, " ", neutral)
// Clearance placement, the rule the website's member chart uses (markerLayout.ts). Newest signals first, each
// pill goes to the nearest spot where it touches nothing: not a candle, the trend line, the corridor, the price
// ribbon or the daily context anywhere across its width, not the room bracket and note, the status panel, the
// symbol legend, a marker or a pill placed before it. Its leader runs straight up or down from the dot, crosses
// no note, panel or pill, and avoids cutting a line. A BUY tries above its dot first and a SELL below: at every
// confirmation the line and the corridor lie on the other side. A pill may centre on its dot, or end or start at
// it; its pointer always sits on the leader. When no dated pill fits it tries the word alone, and when that fails
// the dot keeps the signal and its tooltip keeps the date.
// Pine exposes visible bars and prices, not pixels. Placement assumes a desktop pane of 1,100 by 680 px,
// TradingView's default scale margins (10% top, 8% bottom) and a 10 bar right margin, and checks every vertical
// distance on both a regular and a logarithmic scale. Each pill hangs from its pointer, so TradingView keeps the
// pill itself clear of the data in real pixels on any pane; the pane size only scales the gaps and the room kept
// around the panel, the note and other pills.
float CLEAR_PANE_W = 1100.0
float CLEAR_PANE_H = 680.0
float CLEAR_GAP = 6.0
float CLEAR_DOT = 6.0
float CLEAR_MAX_LEADER = 150.0
int CLEAR_BUCKETS = 220

// A box pills keep clear of, in visible bar slots and prices. A marker is a dot or diamond: a pill keeps clear of
// it, a leader may pass one beside its dot. `owner` is the badge whose own dot it is.
type ClearBox
    float s0
    float s1
    float lo
    float hi
    bool marker = false
    int owner = -1

// The pane as placement sees it: px per visible bar slot, price per px on a regular (ppp) and a logarithmic
// (lpp) scale, and the price at the top edge of the pane on each.
type ClearView
    float ppb
    float ppp
    float lpp
    float topLin
    float topLog

// The price `px` above or below another, on whichever scale lies farther: safe on both.
method upBy(ClearView v, float price, float px) =>
    float lin = price + px * v.ppp
    na(v.lpp) ? lin : math.max(lin, price * math.exp(px * v.lpp))

method downBy(ClearView v, float price, float px) =>
    float lin = price - px * v.ppp
    na(v.lpp) ? lin : math.min(lin, price * math.exp(-px * v.lpp))

method linPx(ClearView v, float price) =>
    (v.topLin - price) / v.ppp

method logPx(ClearView v, float price) =>
    na(v.lpp) or price <= 0 ? na : math.log(v.topLog / price) / v.lpp

// The price at `px` below the pane top: the lower of the two scales, or the higher.
method priceAt(ClearView v, float px, bool lower) =>
    float lin = v.topLin - px * v.ppp
    float logScale = na(v.lpp) ? lin : v.topLog * math.exp(-px * v.lpp)
    lower ? math.min(lin, logScale) : math.max(lin, logScale)

// A price span lies inside the pane, with 2 px to spare, on both scales.
method inPane(ClearView v, float lo, float hi) =>
    bool lin = v.linPx(hi) >= 2 and v.linPx(lo) <= CLEAR_PANE_H - 2
    na(v.lpp) ? lin : lin and lo > 0 and v.logPx(hi) >= 2 and v.logPx(lo) <= CLEAR_PANE_H - 2

// The px between two prices on the scale where they lie farther apart.
method apart(ClearView v, float a, float b) =>
    float lin = math.abs(v.linPx(a) - v.linPx(b))
    na(v.lpp) or a <= 0 or b <= 0 ? lin : math.max(lin, math.abs(v.logPx(a) - v.logPx(b)))

// Two boxes come within `pad` px of each other.
method near(ClearView v, ClearBox a, ClearBox b, float pad) =>
    float slots = pad / v.ppb
    a.s0 - slots < b.s1 and a.s1 + slots > b.s0 and a.lo < v.upBy(b.hi, pad) and a.hi > v.downBy(b.lo, pad)

// The drawn data, bucketed in 5 px columns across the pane.
method bucket(ClearView v, float slot) =>
    math.max(0, math.min(CLEAR_BUCKETS - 1, int(math.floor((slot + 0.5) * v.ppb * CLEAR_BUCKETS / CLEAR_PANE_W))))

f_spread(ClearView v, array<float> highs, array<float> lows, float s0, float s1, float top, float bottom) =>
    if not na(top) and not na(bottom)
        for b = v.bucket(s0) to v.bucket(s1)
            highs.set(b, f_higher(highs.get(b), top))
            lows.set(b, f_lower(lows.get(b), bottom))

f_extent(ClearView v, array<float> highs, array<float> lows, float s0, float s1) =>
    float top = na
    float bottom = na
    for b = v.bucket(s0) to v.bucket(s1)
        top := f_higher(top, highs.get(b))
        bottom := f_lower(bottom, lows.get(b))
    [top, bottom]

// A timestamp as a fractional visible bar slot. Beyond the bars in view, bars of `barMs` continue.
f_clear_slot(int stamp, float barMs) =>
    int n = sceneTimes.size()
    float result = na
    if n > 0 and not na(stamp)
        if stamp >= sceneTimes.get(n - 1)
            result := n - 1 + (stamp - sceneTimes.get(n - 1)) / barMs
        else if stamp <= sceneTimes.get(0)
            result := (stamp - sceneTimes.get(0)) / barMs
        else
            int lo = 0
            int hi = n - 1
            while hi - lo > 1
                int mid = int(math.floor((lo + hi) / 2))
                if sceneTimes.get(mid) <= stamp
                    lo := mid
                else
                    hi := mid
            result := lo + float(stamp - sceneTimes.get(lo)) / (sceneTimes.get(hi) - sceneTimes.get(lo))
    result

// One spot for a pill spanning slots s0 to s1 on one side of the dot at (slot, price): its pointer climbs past
// the drawn data across the pill's width and the gap, then past every box in its way. Returns the cost in px of
// leader, or na where the pill cannot hang, and the pointer's price with the pill's price span.
f_clear_try(ClearView v, array<float> highs, array<float> lows, array<ClearBox> boxes, int owner, float slot, float price, bool above, float s0, float s1, float heightPx, float trend, float band) =>
    float gapSlots = CLEAR_GAP / v.ppb
    [top, bottom] = f_extent(v, highs, lows, s0 - gapSlots, s1 + gapSlots)
    float tip = above ? v.upBy(price, CLEAR_DOT + CLEAR_GAP) : v.downBy(price, CLEAR_DOT + CLEAR_GAP)
    if above and not na(top)
        tip := math.max(tip, v.upBy(top, CLEAR_GAP))
    if not above and not na(bottom)
        tip := math.min(tip, v.downBy(bottom, CLEAR_GAP))
    ClearBox pill = ClearBox.new(s0, s1, above ? tip : v.downBy(tip, heightPx), above ? v.upBy(tip, heightPx) : tip)
    bool moved = true
    int guard = 0
    while moved and guard <= boxes.size()
        moved := false
        guard += 1
        for other in boxes
            if other.owner != owner and v.near(pill, other, CLEAR_GAP)
                tip := above ? v.upBy(other.hi, CLEAR_GAP) : v.downBy(other.lo, CLEAR_GAP)
                pill.lo := above ? tip : v.downBy(tip, heightPx)
                pill.hi := above ? v.upBy(tip, heightPx) : tip
                moved := true
    float leader = v.apart(price, tip) - CLEAR_DOT
    bool fits = v.inPane(pill.lo, pill.hi) and leader <= CLEAR_MAX_LEADER
    ClearBox wire = ClearBox.new(slot - 1 / v.ppb, slot + 1 / v.ppb, above ? v.upBy(price, CLEAR_DOT) : tip, above ? tip : v.downBy(price, CLEAR_DOT))
    if fits
        for other in boxes
            if not other.marker and other.owner != owner and v.near(wire, other, 1)
                fits := false
                break
    // Every line the leader cuts costs 40 px: a clean leader may be that much longer.
    int cuts = 0
    if fits and not na(trend)
        for value in array.from(trend, trend + band, trend - band)
            if not na(value) and value > math.min(price, tip) and value < math.max(price, tip)
                cuts += 1
    [fits ? leader + 40 * cuts : na, tip, pill.lo, pill.hi]

if barstate.islast and actionBadges.size() > 0
    int n = sceneTimes.size()
    float slots = n + (latestInView ? 10.0 : 0.0)
    ClearView v = na
    array<float> highs = array.new_float(CLEAR_BUCKETS, na)
    array<float> lows = array.new_float(CLEAR_BUCKETS, na)
    array<ClearBox> boxes = array.new<ClearBox>()
    array<float> badgeSlots = array.new_float(actionBadges.size(), na)
    if n > 0
        float ppb = CLEAR_PANE_W / slots
        float sceneHigh = na
        float sceneLow = na
        for k = 0 to n - 1
            sceneHigh := f_higher(sceneHigh, f_higher(sceneHighs.get(k), scenePlotHighs.get(k)))
            sceneLow := f_lower(sceneLow, f_lower(sceneLows.get(k), scenePlotLows.get(k)))
        float usable = CLEAR_PANE_H * 0.82
        float ppp = math.max(sceneHigh - sceneLow, math.abs(sceneHigh) * 1e-6) / usable
        float lpp = sceneLow > 0 ? math.max(math.log(sceneHigh / sceneLow), 1e-6) / usable : na
        v := ClearView.new(ppb, ppp, lpp, sceneHigh + 0.10 * CLEAR_PANE_H * ppp, na(lpp) ? na : sceneHigh * math.exp(0.10 * CLEAR_PANE_H * lpp))
        // Candles take their own column; plotted lines reach the neighbouring bar on each side.
        for k = 0 to n - 1
            f_spread(v, highs, lows, k - 0.45, k + 0.45, sceneHighs.get(k), sceneLows.get(k))
            f_spread(v, highs, lows, k - 1, k + 1, scenePlotHighs.get(k), scenePlotLows.get(k))
        // Larger candles draw the line, corridor and price from the weekly points instead.
        if coarse and timeline.size() > 0
            for s in timeline
                if not na(s.line) and not na(s.atr) and s.confirmedAt >= viewLeft - roomBarMs and s.confirmedAt <= viewRight + roomBarMs
                    float at = f_clear_slot(s.confirmedAt, roomBarMs)
                    f_spread(v, highs, lows, at - 1, at + 1, math.max(s.price, s.line + atrBuffer * s.atr), math.min(s.price, s.line - atrBuffer * s.atr))
        // Markers: every dot and diamond, and each diamond's hairline to the sell line.
        float dotSlots = 7 / ppb
        for i = 0 to actionBadges.size() - 1
            float at = f_clear_slot(badgeTimes.get(i), roomBarMs)
            badgeSlots.set(i, at)
            float p = label.get_y(actionDots.get(i))
            if at >= -1 and at <= slots
                boxes.push(ClearBox.new(at - dotSlots, at + dotSlots, v.downBy(p, 7), v.upBy(p, 7), true, i))
        for diamond in warningDots
            float at = f_clear_slot(label.get_x(diamond), roomBarMs)
            if at >= -1 and at <= slots
                boxes.push(ClearBox.new(at - dotSlots, at + dotSlots, v.downBy(label.get_y(diamond), 7), v.upBy(label.get_y(diamond), 7), true))
        for hairline in warningGuides
            float at = f_clear_slot(line.get_x1(hairline), roomBarMs)
            if at >= -1 and at <= slots
                boxes.push(ClearBox.new(at - 2 / ppb, at + 2 / ppb, math.min(line.get_y1(hairline), line.get_y2(hairline)), math.max(line.get_y1(hairline), line.get_y2(hairline)), true))
        // The room bracket one bar right of the latest bar while holding, and its note reading right from there.
        if showOverlay and showRoom and latestInView and roomReady
            if not na(roomPct)
                boxes.push(ClearBox.new(n - 0.25 - 2 / ppb, n + 0.25 + 2 / ppb, math.min(roomClose, roomEdge), math.max(roomClose, roomEdge)))
            if roomNoteShown
                float mid = not na(roomPct) ? math.sqrt(roomClose * roomEdge) : roomClose
                float notePx = (readingSize == "Compact" ? 72.0 : readingSize == "Large" ? 104.0 : 88.0) + 20
                boxes.push(ClearBox.new(n, n + notePx / ppb, v.downBy(mid, bodySize * 1.5 + 6), v.upBy(mid, bodySize * 1.5 + 6)))
        // The status panel in its corner, below its header spacer (4% of the pane) when on top, and the legend.
        if showOverlay and showPanel
            bool top = str.contains(panelCorner, "Top")
            float panelW = math.max(panelSize.get(0) + panelSize.get(1), panelSize.get(2)) + 16
            float panelH = panelSize.get(3) + (top ? 0.04 * CLEAR_PANE_H : 0.0) + 12
            float left = str.contains(panelCorner, "right") ? (CLEAR_PANE_W - panelW) / ppb - 0.5 : -1.0
            float right = str.contains(panelCorner, "right") ? slots + 1 : panelW / ppb - 0.5
            boxes.push(ClearBox.new(left, right, top ? v.priceAt(panelH, true) : -1e300, top ? 1e300 : v.priceAt(CLEAR_PANE_H - panelH, false)))
        boxes.push(ClearBox.new(-1.0, 380 / ppb, v.priceAt(48, true), 1e300))
    // Pills in px: bold label text is about 0.58 of its size wide per character, and the box with its pointer is
    // 27 px tall at size 11 (measured on 1.6.1).
    float charPx = badgeSize * 0.58
    float heightPx = badgeSize * 1.45 + 11
    int budget = signalLabels == "All dated" ? 1000 : readingSize == "Compact" ? 3 : readingSize == "Large" ? 5 : 8
    int labelled = 0
    for i = actionBadges.size() - 1 to 0
        int stamp = badgeTimes.get(i)
        bool buy = badgeKinds.get(i) == 1
        label badge = actionBadges.get(i)
        line guide = actionGuides.get(i)
        float price = label.get_y(actionDots.get(i))
        float at = badgeSlots.get(i)
        string word = buy ? "BUY" : "SELL"
        float bestCost = na
        float bestTip = na
        float bestS0 = na
        float bestS1 = na
        float bestLo = na
        float bestHi = na
        bool bestAbove = true
        int bestShift = 0
        string caption = ""
        if not na(v) and not na(at) and at >= -0.5 and at <= n - 0.5 + (coarse ? 1 : 0) and labelled < budget
            for attempt = (signalLabels == "Signals only" ? 1 : 0) to 1
                string candidate = attempt == 0 ? word + " · " + f_badge_date(stamp) : word
                float span = (str.length(candidate) * charPx + 18) / v.ppb
                float inset = 2 / v.ppb
                for side = 0 to 1
                    bool above = side == 0 ? buy : not buy
                    for shift in array.from(0, -1, 1)
                        // Centred on the dot, ending at it, or starting at it. The pointer anchors the pill to the
                        // dot, so a spot that would leave the pane is skipped rather than slid inward.
                        float s0 = shift == 0 ? at - span / 2 : shift < 0 ? at - span + inset : at - inset
                        float total = na
                        float tip = na
                        float lo = na
                        float hi = na
                        if s0 >= -0.5 and s0 + span <= slots - 0.5
                            [cost, pointer, pillLo, pillHi] = f_clear_try(v, highs, lows, boxes, i, at, price, above, s0, s0 + span, heightPx, badgeLines.get(i), badgeBands.get(i))
                            total := cost + (side == 1 ? 16 : 0) + (shift != 0 ? 8 : 0)
                            tip := pointer
                            lo := pillLo
                            hi := pillHi
                        if not na(total) and (na(bestCost) or total < bestCost)
                            bestCost := total
                            bestTip := tip
                            bestS0 := s0
                            bestS1 := s0 + span
                            bestLo := lo
                            bestHi := hi
                            bestAbove := above
                            bestShift := shift
                            caption := candidate
                if not na(bestCost)
                    break
        if not na(bestCost)
            labelled += 1
            // The pointer sits on the leader's end, at the centre or the corner nearest the dot.
            label.set_style(badge, bestAbove ? (bestShift == 0 ? label.style_label_down : bestShift < 0 ? label.style_label_lower_right : label.style_label_lower_left) : (bestShift == 0 ? label.style_label_up : bestShift < 0 ? label.style_label_upper_right : label.style_label_upper_left))
            label.set_xy(badge, stamp, bestTip)
            label.set_text(badge, caption)
            label.set_color(badge, buy ? buyPill : sellPill)
            line.set_xy1(guide, stamp, price)
            line.set_xy2(guide, stamp, bestTip)
            line.set_color(guide, buy ? color.new(gold, 45) : color.new(sellDot, 50))
            boxes.push(ClearBox.new(bestS0, bestS1, bestLo, bestHi))
            boxes.push(ClearBox.new(at - 1 / v.ppb, at + 1 / v.ppb, math.min(price, bestTip), math.max(price, bestTip)))
        else
            label.set_text(badge, "")
            label.set_color(badge, color.new(background, 100))
            line.set_color(guide, color.new(background, 100))

if weekly and barstate.isconfirmed and assetReady
    string eventName = bull and bullAlerts ? "BUY" : bear and bearAlerts ? "SELL" : warning and warningAlerts ? (bandExit ? "Warning · closed below the sell line, not a SELL" : "Warning · trend weakening, not a SELL") : ""
    if eventName != ""
        alert("Three Towers | " + syminfo.tickerid + " | " + eventName + " | Weekly confirmed " + f_confirmation_time(asset.confirmedAt) + " UTC | Bitcoin: " + f_name(btc, btcFresh), alert.freq_once_per_bar_close)

// TradingView's slippage property is TICKS, not percent. Percentage scenarios live
// in the reference backtest. This strategy uses 0.3% commission and 0 ticks by default.
int testStart = input.time(timestamp("1970-01-01T00:00:00+00:00"), "First signal date", group = "Backtest")
int testEnd = input.time(timestamp("2099-01-01T00:00:00+00:00"), "Last signal date (exclusive)", group = "Backtest")
if barstate.isfirst and not nativeTf
    runtime.error("Run the baseline backtest on standard 1W candles. Other intervals are indicator viewing surfaces.")
if testEnd <= testStart
    runtime.error("Last signal date must follow first signal date.")
bool inRange = time_close >= testStart and time_close < testEnd
bool enterExisting = input.bool(false, "Enter existing bull at start", group = "Backtest")
var bool started = false
if barstate.isconfirmed and inRange and assetReady and (bull or (enterExisting and not started and asset.regime == 1))
    strategy.entry("Trend long", strategy.long)
if barstate.isconfirmed and inRange and assetReady
    started := true
if barstate.isconfirmed and bear and strategy.position_size > 0
    strategy.close("Trend long", comment = "Bearish confirmation")
if barstate.isconfirmed and time_close >= testEnd and strategy.position_size > 0
    strategy.close("Trend long", comment = "End of test window")
